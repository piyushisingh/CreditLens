# ==========================================
# Datasets & Data Files
# Raw datasets are excluded from Git.
# Anonymised test fixtures in designated test directories are permitted.
# ==========================================
*.csv
*.tsv
*.parquet
*.sqlite3
!tests/fixtures/*.csv
!backend/tests/fixtures/*.csv

# ==========================================
# Machine Learning Model Artifacts
# ==========================================
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.h5
!backend/ml/artifacts/model_pipeline.joblib
!backend/ml/artifacts/metadata.json
!backend/ml/artifacts/.gitkeep

# ==========================================
# Secrets, Keys & Credentials
# ==========================================
.env
.env.*
*.key
*.pem
credentials.json
keystore.properties
*.jks
*.keystore
google-services.json

# ==========================================
